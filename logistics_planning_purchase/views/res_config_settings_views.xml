<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="logistics_planning_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='logistics_planning_base']" position="inside">
                <block title="Purchase" name="lg_purchase_setting_container">
                    <setting string="Default product in purchase for one line" id="ls_default_one_line_product_id">
                        <field name="ls_default_one_line_product_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
