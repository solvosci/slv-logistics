<odoo>
    <record id="action_report_logistics_schedule_deca_waybill" model="ir.actions.report">
        <field name="name">Waybill (DeCA)</field>
        <field name="model">logistics.schedule</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">logistics_planning_deca.report_logistics_schedule_waybill</field>
        <field name="report_file">logistics_planning_deca.report_logistics_schedule_waybill</field>
        <field name="print_report_name">'Waybill - %s' % (object.name or object.id)</field>
        <field name="binding_model_id" ref="model_logistics_schedule"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_logistics_schedule_waybill">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-call="logistics_planning_deca.report_logistics_schedule_waybill_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_logistics_schedule_waybill_document">
        <t t-set="doc" t-value="doc.with_context({'lang': doc.partner_id.lang or doc.env.lang})"/>
        <t t-set="company_partner" t-value="doc.company_id.partner_id"/>

        <div class="page ml-3 mr-3">
            <div class="header row ml-3 mb-4" style="align-items: center;" name="div-header">
                <div style="max-width: 250px !important;" class="col-3" t-if="doc.company_id.logo">
                    <img t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 40px; width: auto;" alt="Company Logo"/>
                </div>
                <div style="font-size: 16px; padding-left: 10px" class="col-4">
                    <ul style="padding-left: 0;">
                        <li style="list-style-type: none; font-weight: bold; font-size: 16px">
                            <span t-esc="doc.company_id.name"/>, <span t-esc="company_partner.street"/>
                        </li>
                        <li style="list-style-type: none;" t-if="company_partner.city">
                            <span t-esc="company_partner.city"/>
                        </li>
                        <li style="list-style-type: none;" t-if="company_partner.phone">
                            <span t-esc="company_partner.phone"/>
                        </li>
                        <li style="list-style-type: none;">
                            <span t-esc="company_partner.website or ''"/>
                        </li>
                        <li style="list-style-type: none;" t-if="company_partner.vat">
                            VAT <span t-esc="company_partner.vat"/>
                        </li>
                    </ul>
                </div>
                <div class="col-5" style="text-align: center;">
                    <img t-attf-src="data:image/png;base64,{{doc.deca_qr}}" style="width: 120px; height: 120px;"/>
                    <br/>DeCA
                </div>
            </div>
            <div class="oe_structure"/>
            <h1 class="text-center" style="text-decoration: underline; margin-bottom: 40px">WAYBILL</h1>
            <table class="w-75" style="font-size: 16px; margin-bottom: 25px;" name="table-picking">
                <tbody>
                    <tr>
                        <td style="width: 375px;"><strong>Schedule / Ref:</strong></td>
                        <td><span t-field="doc.deca_sequence"/></td>
                    </tr>
                    <tr>
                        <td style="width: 375px;"><strong>Expedition date:</strong></td>
                        <td>
                            <span t-esc="doc.commitment_date or doc.scheduled_load_date or datetime.date.today()" t-options="{'widget': 'date'}"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 375px;"><strong>License Plate Tractor Head:</strong></td>
                        <td><span t-field="doc.license_plate_1"/></td>
                    </tr>
                    <tr>
                        <td style="width: 375px;"><strong>Towing License Plate:</strong></td>
                        <td><span t-field="doc.license_plate_2"/></td>
                    </tr>
                    <!-- (Sender) -->
                    <tr>
                        <td style="width: 375px;"><strong>Sender:</strong></td>
                        <td><span t-esc="doc.partner_id.name"/></td>
                    </tr>
                    <tr>
                        <td style="width: 375px;"><strong>Address:</strong></td>
                        <td><span t-esc="doc.partner_id.street or ''"/></td>
                    </tr>
                    <tr>
                        <td style="width: 375px;"><strong>Location:</strong></td>
                        <td>
                            <span t-esc="doc.partner_id.zip or ''"/>
                            <span t-esc="doc.partner_id.city or ''"/>
                            <t t-if="doc.partner_id.state_id">
                                (<span t-esc="doc.partner_id.state_id.name"/>)
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 375px;"><strong>VAT:</strong></td>
                        <td><span t-esc="doc.partner_id.vat or ''"/></td>
                    </tr>
                </tbody>
            </table>

            <!-- (Addressee) -->
            <table class="w-75" style="font-size: 16px; margin-bottom: 25px;" name="table-addressee" t-if="company_partner">
                <tbody>
                    <tr>
                        <td class="d-flex" style="width: 375px;"><strong>Addressee:</strong></td>
                        <td class="w-100">
                            <span t-field="company_partner.name"/><br/>
                            <span t-field="company_partner.street" t-if="company_partner.street"/><br t-if="company_partner.street"/>
                            <span t-field="company_partner.zip"/>
                            <span t-field="company_partner.city"/><br/>
                            <span t-field="company_partner.vat" t-if="company_partner.vat"/>
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- (Carrier) -->
            <t t-set="carrier" t-value="doc.effective_carrier_id or doc.carrier_id"/>
            <table class="w-75" style="font-size: 16px; margin-bottom: 25px;" name="table-carrier" t-if="carrier">
                <tbody>
                    <tr>
                        <td class="d-flex" style="width: 375px;"><strong>Carrier:</strong></td>
                        <td class="w-100">
                            <span t-field="carrier.name"/><br/>
                            <span t-field="carrier.street" t-if="carrier.street"/><br t-if="carrier.street"/>
                            <span t-field="carrier.zip"/>
                            <span t-field="carrier.city"/><br/>
                            <span t-field="carrier.vat" t-if="carrier.vat"/>
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- (Driver) -->
            <table class="w-75" style="font-size: 16px; margin-bottom: 25px;" name="table-driver" t-if="doc.deca_driver_id">
                <tbody>
                    <tr>
                        <td class="d-flex" style="width: 375px;"><strong>Driver:</strong></td>
                        <td class="w-100">
                            <span t-field="doc.deca_driver_id.name"/><br/>
                            <span t-field="doc.deca_driver_id.street" t-if="doc.deca_driver_id.street"/><br t-if="doc.deca_driver_id.street"/>
                            <span t-field="doc.deca_driver_id.zip"/>
                            <span t-field="doc.deca_driver_id.city"/><br/>
                            <span t-if="doc.deca_driver_id.vat">VAT: <span t-field="doc.deca_driver_id.vat"/></span>
                        </td>
                    </tr>
                </tbody>
            </table>

            <table style="font-size: 16px; width: 65%;" name="table-items">
                <thead>
                    <tr class="border-bottom">
                        <th style="text-align: left">Quality / Product</th>
                        <th style="text-align: left">Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-if="doc.product_id">
                        <td><span t-field="doc.product_id.display_name"/></td>
                        <td>
                            <span t-field="doc.product_uom_qty"/>
                            <span t-if="doc.product_uom" t-field="doc.product_uom.name"/>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="row mt-4" t-if="doc.deca_signature">
                <div class="col-6 offset-6 text-center">
                    <strong>Authorized Signature:</strong><br/>
                    <img t-att-src="image_data_uri(doc.deca_signature)" style="max-height: 2.5cm; max-width: 100%;"/>
                </div>
            </div>
        </div>
    </template>
</odoo>
