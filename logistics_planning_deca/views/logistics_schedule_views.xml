<odoo>
    <record id="action_generate_deca" model="ir.actions.server">
        <field name="name">(Re)generate DeCA</field>
        <field
            name="model_id"
            ref="logistics_planning_base.model_logistics_schedule"
        />
        <field
            name="binding_model_id"
            ref="logistics_planning_base.model_logistics_schedule"
        />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
        if records:
            res = records.action_generate_deca()
            if isinstance(res, dict):
                action = res
        </field>
    </record>

    <record id="logistics_schedule_input_view_tree" model="ir.ui.view">
        <field name="name">logistics.schedule.tree input (in logistics_planning_deca)</field>
        <field name="model">logistics.schedule</field>
        <field name="inherit_id" ref="logistics_planning_base.logistics_schedule_input_view_tree"/>
        <field name="arch" type="xml">
            <field name="origin" position="before">
                <field
                    name="deca_sequence"
                    string="DECA seq."
                    optional="show"
                />
            </field>
        </field>
    </record>

    <record id="logistics_schedule_view_form" model="ir.ui.view">
        <field name="name">logistics.schedule.form (in logistics_planning_deca)</field>
        <field name="model">logistics.schedule</field>
        <field name="inherit_id" ref="logistics_planning_base.logistics_schedule_view_form"/>
        <field name="arch" type="xml">
            <field name="effective_carrier_id" position="after">
                <field name="deca_driver_id" domain="[('is_company', '=', False)]"/>
            </field>

            <header position="inside">
                <field name="deca_is_generated" invisible="1"/>
                <button
                    string="Generate DeCA"
                    name="action_generate_deca"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('deca_is_generated', '=', True), ('state', 'not in', ('ready', 'done'))]}"
                />
                <button
                    string="Re-generate DeCA"
                    name="action_generate_deca"
                    type="object"
                    class="btn-secondary"
                    attrs="{'invisible': [('deca_is_generated', '=', False), ('state', 'not in', ('ready', 'done'))]}"
                />
            </header>

            <sheet position="inside">
                <notebook>
                    <page string="DeCA Document" name="deca_document" >
                        <group>
                            <group string="Signature">
                                <field name="deca_signature" widget="signature"/>
                            </group>
                            <group string="DeCA PDF &amp; Metadata" attrs="{'invisible': [('deca_is_generated', '=', False)]}">
                                <field
                                    name="deca_attachment_id"
                                    widget="many2one_binary"
                                    filename="deca_attachment_id"
                                    string="Attachment"
                                />
                                <field
                                    name="deca_generation_date"
                                    readonly="1"
                                    string="Generation Date"
                                />
                                <field
                                    name="deca_generated_by_id"                                    
                                    readonly="1"
                                    string="Generated By"
                                />
                            </group>
                        </group>
                        <group string="DeCA Public Access" attrs="{'invisible': [('deca_is_generated', '=', False)]}">
                            <group>                                
                                <field
                                    name="deca_hash_string"
                                    readonly="1"
                                    groups="base.group_no_one"
                                    string="Hash String"
                                />
                                <field
                                    name="deca_hash"
                                    readonly="1"
                                    groups="base.group_no_one"
                                    string="Hash"
                                />
                                <field
                                    name="deca_sequence"
                                    string="Sequence"
                                />
                                <field
                                    name="deca_url"                                    
                                    widget="url"
                                    readonly="1"
                                    string="URL"
                                />
                            </group>
                            <group>
                                <field
                                    name="deca_qr"
                                    widget="image"
                                    class="oe_avatar"
                                    readonly="1"
                                />
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

    <record id="logistics_schedule_view_search" model="ir.ui.view">
        <field name="name">logistics.schedule.search (in logistics_planning_deca)</field>
        <field name="model">logistics.schedule</field>
        <field
            name="inherit_id"
            ref="logistics_planning_base.logistics_schedule_view_search"
        />
        <field name="arch" type="xml">
            <filter name="scheduled_load_date" position="before">
                <filter
                    name="filter_deca_documents"
                    string="DeCA documents"
                    domain="[('deca_is_generated', '=', True)]"
                />
                <separator/>
            </filter>
        </field>
    </record>
</odoo>
