<odoo>
    <record id="logistics_schedule_view_form" model="ir.ui.view">
        <field name="name">logistics.schedule.form (in logistics_planning_deca)</field>
        <field name="model">logistics.schedule</field>
        <field name="inherit_id" ref="logistics_planning_base.logistics_schedule_view_form"/>
        <field name="arch" type="xml">
            <field name="effective_carrier_id" position="after">
                <field name="deca_driver_id" domain="[('is_company', '=', False)]"/>
            </field>

            <header position="inside">
                <field name="deca_is_generated" invisible="1"/>
                <button
                    string="Generate DeCA"
                    name="action_generate_deca"
                    type="object"
                    class="oe_highlight"
                    invisible="deca_is_generated"
                />
                <button
                    string="Re-generate DeCA"
                    name="action_generate_deca"
                    type="object"
                    class="btn-secondary"
                    invisible="not deca_is_generated"
                />
            </header>

            <sheet position="inside">
                <notebook>
                    <page string="DeCA Document" name="deca_document">
                        <group>
                            <group string="Signature">
                                <field name="deca_signature" widget="signature"/>
                            </group>
                            <group string="DeCA PDF &amp; Metadata">
                                <field name="deca_attachment_id" widget="many2one_binary" filename="deca_attachment_id"/>
                                <field name="deca_generation_date" readonly="1"/>
                                <field name="deca_generated_by_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="DeCA Public Access">
                            <group>
                                <field name="deca_url" widget="url" readonly="1"/>
                            </group>
                            <group>
                                <field name="deca_qr" widget="image" class="oe_avatar" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>
</odoo>