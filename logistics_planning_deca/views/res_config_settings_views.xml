<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="logistics_planning_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='logistics_planning_base']/block" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//app[@name='logistics_planning_base']" position="inside">
                <block title="DECa" name="lg_deca_setting_container">
                    <setting string="Users Notified of Portal Logistics DECa Generations" id="ls_portal_notification_user_ids">
                        <field name="ls_portal_notification_user_ids"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
