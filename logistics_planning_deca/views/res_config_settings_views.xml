<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="logistics_planning_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='logistics_planning_base']" position="inside">
                <h2>DeCA</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="ls_portal_notification_user_ids"/>
                            <div class="text-muted">
                                Users Notified of Portal Logistics DeCA Generations
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="ls_portal_notification_user_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="ls_deca_sequence"/>
                            <div class="text-muted">
                                Sequence given to DeCA Documents generated in logistics
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="ls_deca_sequence"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
